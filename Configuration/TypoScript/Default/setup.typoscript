# The setup of the plugin configuration all content elements of this extension share.
#
# See "constants.typoscript" next to it for why one shared block exists instead
# of six copies. Every component folder reaches this file through its own
# "include_static_file.txt", so a site that includes all six components parses
# it six times. That is harmless on purpose: everything here is a plain
# assignment, and the one list built with "addToList" - the
# "ignoreFlexFormSettingsIfEmpty" block imported at the end - only ever gains
# duplicates of its own entries, which Extbase resolves to the same result.
plugin.tx_academicpersons {
  settings {
    detailPid = {$plugin.tx_academicpersons.detailPid}
    demand {
      groupBy = {$plugin.tx_academicpersons.demand.groupBy}
      sortBy = {$plugin.tx_academicpersons.demand.sortBy}
      sortByDirection = {$plugin.tx_academicpersons.demand.sortByDirection}
      profileList =
    }
    pagination {
      resultsPerPage = {$plugin.tx_academicpersons.pagination.resultsPerPage}
      numberOfLinks = {$plugin.tx_academicpersons.pagination.numberOfLinks}
    }
    alphabet {
      activeLetterResets = {$plugin.tx_academicpersons.alphabet.activeLetterResets}
    }
    viewMode {
      allowed = {$plugin.tx_academicpersons.viewMode.allowed}
    }
    table {
      columns = {$plugin.tx_academicpersons.table.columns}
    }
    image {
      placeholder {
        default = {$plugin.tx_academicpersons.image.placeholder.default}
      }
    }
    phoneNumbers {
      telPrefix = {$plugin.tx_academicpersons.phoneNumbers.telPrefix}
    }
    # The content element layout renders the header of every content element, so the
    # templates render it only for a site whose layout leaves it out. The header partial
    # falls back to the type of the header layout "Default" through the setting below,
    # which plugin settings do not carry the way the settings of `lib.contentElement` do.
    renderContentElementHeader = {$plugin.tx_academicpersons.renderContentElementHeader}
    defaultHeaderType = {$styles.content.defaultHeaderType}
  }
  view {
    templateRootPaths {
      0 = EXT:academic_persons/Resources/Private/Templates/
      1 = {$plugin.tx_academicpersons.view.templateRootPath}
    }
    partialRootPaths {
      # The header partial of EXT:fluid_styled_content, which the templates render while
      # "renderContentElementHeader" is switched on. The key sorts below every other one,
      # the shared partials of EXT:academic_base included, so a "Header/All" of the
      # project wins over it.
      -2 = EXT:fluid_styled_content/Resources/Private/Partials/
      # The shared partials of EXT:academic_base ("Academic/Image"). The key sorts below
      # the paths of this extension and of the project, so a partial of either wins over them.
      -1 = EXT:academic_base/Resources/Private/Partials/
      0 = EXT:academic_persons/Resources/Private/Partials/
      1 = {$plugin.tx_academicpersons.view.partialRootPath}
    }
    layoutRootPaths {
      0 = EXT:academic_persons/Resources/Private/Layouts/
      1 = {$plugin.tx_academicpersons.view.layoutRootPath}
    }
  }
}

config.pageTitleProviders {
    profile  {
        provider = FGTCLB\AcademicPersons\PageTitle\ProfileTitleProvider
        before = calendarize,altPageTitle,record,seo
    }
}

// ----------------------------------------------------------------------------------------------------------------------
//  Add following FlexForm settings (settings.<identifier>) to be allowed overridden in TypoScript if empty in FlexForm,
//  still taking set values in FlexForm as the higher candidates but have a sane fallback to system wide defaults.
//
//  https://docs.typo3.org/c/typo3/cms-core/main/en-us/Changelog/12.3/Feature-99976-IntroduceignoreFlexFormSettingsIfEmptyExtbaseConfiguration.html
// ----------------------------------------------------------------------------------------------------------------------
@import 'EXT:academic_persons/Configuration/TypoScript/Shared/allow_typoscript_override_empty_flexform_settings.typoscript'
// ----------------------------------------------------------------------------------------------------------------------
