# Page TSconfig of the profile card content element.
#
# Delivered by the set "fgtclb/academic-persons-card" and registered for the
# page field "Page TSconfig" by "Configuration/TCA/Overrides/pages.php" - one
# physical copy, two ways to it.
#
# The content element is hidden for the whole installation by
# "Configuration/page.tsconfig"; this file is what makes it selectable again,
# so it applies where the component is actually wanted instead of everywhere.
#
# It also carries the FlexForm restriction of this one content element: the card
# renders a fixed selection of profiles, so the list, sorting and pagination
# fields of the shared FlexForm are of no use in it and are hidden. That block
# travels with the component instead of applying installation wide, so an
# installation that does not use the card is not configured for it either.
TCEFORM.tt_content.CType.removeItems := removeFromList(academicpersons_card)

mod.wizards.newContentElement.wizardItems.academic {
  elements {
    academicpersons_card {
      iconIdentifier = actions-user
      title = LLL:EXT:academic_persons/Resources/Private/Language/locallang_be.xlf:newContentElement.wizardItems.academic.card.title
      description = LLL:EXT:academic_persons/Resources/Private/Language/locallang_be.xlf:newContentElement.wizardItems.academic.card.description
      tt_content_defValues {
        CType = academicpersons_card
      }
    }
  }
}

TCEFORM.tt_content {
  pi_flexform {
    academicpersons_card {
      sDEF {
        settings\.detailPid.disabled = 1
        settings\.demand\.groupBy.disabled = 1
        settings\.demand\.sortBy.disabled = 1
        settings\.demand\.sortByDirection.disabled = 1
        settings\.paginationEnabled.disabled = 1
        settings\.alphabetPaginationEnabled.disabled = 1
        settings\.pagination\.resultsPerPage.disabled = 1
        settings\.pagination\.numberOfLinks.disabled = 1
        settings\.viewMode\.enabled.disabled = 1
        settings\.viewMode\.default.disabled = 1
      }
    }
  }
}
