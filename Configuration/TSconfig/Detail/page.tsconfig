# Page TSconfig of the profile detail content element.
#
# Delivered by the set "fgtclb/academic-persons-detail" and registered for the
# page field "Page TSconfig" by "Configuration/TCA/Overrides/pages.php" - one
# physical copy, two ways to it.
#
# The content element is hidden for the whole installation by
# "Configuration/page.tsconfig"; this file is what makes it selectable again,
# so it applies where the component is actually wanted instead of everywhere.
TCEFORM.tt_content.CType.removeItems := removeFromList(academicpersons_detail)

mod.wizards.newContentElement.wizardItems.academic {
  elements {
    academicpersons_detail {
      iconIdentifier = persons_icon
      title = LLL:EXT:academic_persons/Resources/Private/Language/locallang_be.xlf:newContentElement.wizardItems.academic.detail.title
      description = LLL:EXT:academic_persons/Resources/Private/Language/locallang_be.xlf:newContentElement.wizardItems.academic.detail.description
      tt_content_defValues {
        CType = academicpersons_detail
      }
    }
  }
}
