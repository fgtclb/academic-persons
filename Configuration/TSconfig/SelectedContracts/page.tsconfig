# Page TSconfig of the selected contracts content element.
#
# Delivered by the set "fgtclb/academic-persons-selected-contracts" and
# registered for the page field "Page TSconfig" by
# "Configuration/TCA/Overrides/pages.php" - one physical copy, two ways to it.
#
# The content element is hidden for the whole installation by
# "Configuration/page.tsconfig"; this file is what makes it selectable again,
# so it applies where the component is actually wanted instead of everywhere.
TCEFORM.tt_content.CType.removeItems := removeFromList(academicpersons_selectedcontracts)

mod.wizards.newContentElement.wizardItems.academic {
  elements {
    academicpersons_selectedcontracts {
      iconIdentifier = actions-user
      title = LLL:EXT:academic_persons/Resources/Private/Language/locallang_be.xlf:plugin.selectedcontracts.label
      description = LLL:EXT:academic_persons/Resources/Private/Language/locallang_be.xlf:plugin.selectedcontracts.description
      tt_content_defValues {
        CType = academicpersons_selectedcontracts
      }
    }
  }
}
